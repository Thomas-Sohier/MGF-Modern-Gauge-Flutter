# Surcouche de l'image de configuration BLE (à combiner avec sdkconfig.defaults).
#   idf.py -B build-ble -D SDKCONFIG=build-ble/sdkconfig \
#       -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.ble" \
#       -D MGF_ENABLE_BLE_CONFIG=1 build
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_MAX_BONDS=3
