# ── Cible : ESP32-S3R8 (LILYGO T-RGB 2.1 Full Circle H597) ──────────────────
CONFIG_IDF_TARGET="esp32s3"

# Le profil K-line reprend GPIO40/GPIO38, anciennes CMD/DAT0 microSD.
# SDMMC n'est volontairement pas activé ; les pins sont possédées par l'UART.
# Les sélecteurs MGF_KLINE_* sont des variables CMake dans main/CMakeLists.txt.

# ── PSRAM octale 8 Mo @ 80 MHz (framebuffers RGB + buffers LVGL) ──────────────
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# NB : on NE met PAS le code/rodata en PSRAM (SPIRAM_FETCH_INSTRUCTIONS/RODATA)
# pour laisser toute la bande passante PSRAM au framebuffer RGB (anti-flicker).

# ── CPU 240 MHz ───────────────────────────────────────────────────────────────
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# ── Flash 16 Mo QIO 80 MHz + table de partitions personnalisée ───────────────
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ── Panneau RGB : ISR en IRAM (stabilité du rafraîchissement avec la PSRAM) ───
# Profil LCD : original par défaut (8 MHz). Construire avec
# -DMGF_LILYGO_T_RGB_V2=1 pour la révision V2 (10 MHz + autre ordre RGB).
# CONFIG_LCD_RGB_ISR_IRAM_SAFE is not set

# La composition initiale de tous les écrans LVGL dépasse la pile IDF par défaut.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# ── Tactile CST820 (H597, pilote compatible CST816S) ────────────────────────
# board_display.c réveille le CST820 (reset XL9535 IO1), désactive sa veille
# automatique (sinon NACK I²C jusqu'au prochain appui) puis journalise l'ID
# lui-même : la lecture d'ID du pilote serait redondante.
CONFIG_ESP_LCD_TOUCH_CST816S_DISABLE_READ_ID=y

# ── LVGL ──────────────────────────────────────────────────────────────────────
CONFIG_LV_COLOR_DEPTH_16=y            # RGB565, cohérent avec le panneau
# Allocateur C (heap ESP-IDF) au lieu du pool LVGL fixe de 64 Ko : les
# 11 pages créées au boot + les caches tiny_ttf ne tiennent pas de façon sûre
# dans 64 Ko. Les petits blocs restent en RAM interne, le reste bascule en
# PSRAM (CONFIG_SPIRAM_USE_MALLOC). Même allocateur que le simulateur hôte.
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_TINY_TTF=y              # rendu Michroma à la volée (style ambre)
CONFIG_LV_USE_TJPGD=y                 # décodeur JPEG (pochette compagnon)
CONFIG_LV_USE_VECTOR_GRAPHIC=y         # logo vectoriel de l'écran de boot
CONFIG_LV_USE_MATRIX=y                 # dépendance du rendu vectoriel
CONFIG_LV_USE_FLOAT=y                  # dépendance du rendu vectoriel
CONFIG_LV_DEF_REFR_PERIOD=30
CONFIG_LV_FONT_MONTSERRAT_20=y        # fallback si le TTF échoue
CONFIG_LV_FONT_MONTSERRAT_48=y

# ── Bluetooth : lien permanent avec l'application compagnon ───────────────────
# NimBLE seul (pas de Bluedroid ni de BT classique, absent de l'ESP32-S3).
# ~36 Ko de DIRAM statique, cf. docs/ble-config.md.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_MAX_BONDS=3
# Bonds conservés en NVS : sans cela le téléphone devrait se ré-appairer à
# chaque démarrage et la reconnexion automatique serait impossible.
CONFIG_BT_NIMBLE_NVS_PERSIST=y
# Périphérique uniquement.
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
# Le JSON du compagnon est décodé dans la tâche hôte (~1,5 Ko de pile).
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=6144
# Écritures longues (JSON jusqu'à 512 octets en « prepare write ») : marge de
# tampons au-delà des 12 blocs par défaut.
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=24

# ── Log ───────────────────────────────────────────────────────────────────────
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
