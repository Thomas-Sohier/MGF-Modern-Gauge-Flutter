# ── Cible : ESP32-S3R8 (LILYGO T-RGB 2.1 Full Circle H597) ──────────────────
CONFIG_IDF_TARGET="esp32s3"

# ── PSRAM octale 8 Mo @ 80 MHz (framebuffers RGB + buffers LVGL) ──────────────
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# NB : on NE met PAS le code/rodata en PSRAM (SPIRAM_FETCH_INSTRUCTIONS/RODATA)
# pour laisser toute la bande passante PSRAM au framebuffer RGB (anti-flicker).

# ── CPU 240 MHz ───────────────────────────────────────────────────────────────
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# ── Flash 16 Mo QIO 80 MHz + table de partitions personnalisée ───────────────
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ── Panneau RGB : ISR en IRAM (stabilité du rafraîchissement avec la PSRAM) ───
# Profil LCD : original par défaut (8 MHz). Construire avec
# -DMGF_LILYGO_T_RGB_V2=1 pour la révision V2 (10 MHz + autre ordre RGB).
CONFIG_LCD_RGB_ISR_IRAM_SAFE=y

# ── LVGL ──────────────────────────────────────────────────────────────────────
CONFIG_LV_COLOR_DEPTH_16=y            # RGB565, cohérent avec le panneau
CONFIG_LV_USE_TINY_TTF=y              # rendu Michroma à la volée (style ambre)
CONFIG_LV_USE_VECTOR_GRAPHIC=y         # logo vectoriel de l'écran de boot
CONFIG_LV_USE_MATRIX=y                 # dépendance du rendu vectoriel
CONFIG_LV_USE_FLOAT=y                  # dépendance du rendu vectoriel
CONFIG_LV_DEF_REFR_PERIOD=30          # ~30 Hz (régime moteur simulé)
CONFIG_LV_FONT_MONTSERRAT_20=y        # fallback si le TTF échoue
CONFIG_LV_FONT_MONTSERRAT_48=y

# ── Log ───────────────────────────────────────────────────────────────────────
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
