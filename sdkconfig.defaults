# ── Cible ────────────────────────────────────────────────────────────────────
CONFIG_IDF_TARGET="esp32p4"

# ── PSRAM (obligatoire : framebuffers MIPI-DSI + buffers LVGL) ────────────────
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y

# ── Fréquence CPU max ─────────────────────────────────────────────────────────
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y

# ── LVGL : polices Montserrat utilisées par l'écran RPM ───────────────────────
# (valeur centrale, sous-titre, labels des indicateurs)
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_48=y

# Couleur 16 bits (RGB565) — cohérent avec le panneau et le port LVGL.
CONFIG_LV_COLOR_DEPTH_16=y

# Rafraîchissement fluide pour l'animation du régime moteur simulé (~30 Hz).
CONFIG_LV_DEF_REFR_PERIOD=30

# Rendu TTF à la volée (JetBrains Mono monospace, style ambre).
CONFIG_LV_USE_TINY_TTF=y

# ── Flash 16 Mo + table de partitions personnalisée ──────────────────────────
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ── Log ───────────────────────────────────────────────────────────────────────
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
